rules_version = '2';

// Paste this into Firebase Console > Firestore Database > Rules.
// Every read/write is restricted to the single shared account both of you
// sign into (see README "Setup" for creating it). Anyone without that
// account's password — including someone who finds this site's URL or reads
// this public repo's source — is rejected server-side, not just hidden by
// the UI.
service cloud.firestore {
  match /databases/{database}/documents {
    function isFamily() {
      return request.auth != null && request.auth.token.email == "timka@team.family";
    }

    match /entries/{entryId} {
      allow read, write: if isFamily();
    }

    match /settings/{docId} {
      allow read, write: if isFamily();
    }

    // Registered push tokens, one doc per device. Only the Cloud Function
    // (running with admin privileges, bypassing these rules) reads across
    // all of them to fan out a notification; clients only ever write their
    // own device's doc.
    match /devices/{token} {
      allow read, write: if isFamily();
    }
  }
}
